{
  "name": "at-grafana",
  "displayName": "AT Grafana",
  "description": "Grafana dashboards, alerts, and datasource access inside VS Code, with Agent (MCP) integration via AT Series.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atGrafana",
          "title": "AT Grafana",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "atGrafana": [
        {
          "id": "atGrafana.dashboards",
          "name": "Dashboards"
        },
        {
          "id": "atGrafana.alerts",
          "name": "Alerts"
        }
      ]
    },
    "commands": [
      {
        "command": "atGrafana.addInstance",
        "title": "AT Grafana: Add Instance"
      },
      {
        "command": "atGrafana.manageInstances",
        "title": "AT Grafana: Manage Instances"
      },
      {
        "command": "atGrafana.installMcpConfig",
        "title": "AT Grafana: Install/Repair AT Series MCP Config"
      },
      {
        "command": "atGrafana.uninstallAtSeriesMcpConfig",
        "title": "AT Grafana: Uninstall AT Series MCP Config"
      },
      {
        "command": "atGrafana.refreshDashboards",
        "title": "AT Grafana: Refresh Dashboards",
        "icon": "$(refresh)"
      },
      {
        "command": "atGrafana.filterDashboards",
        "title": "AT Grafana: Filter Dashboards",
        "icon": "$(filter)"
      },
      {
        "command": "atGrafana.clearDashboardFilter",
        "title": "AT Grafana: Clear Dashboard Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "atGrafana.refreshAlerts",
        "title": "AT Grafana: Refresh Alerts",
        "icon": "$(refresh)"
      },
      {
        "command": "atGrafana.openDashboard",
        "title": "AT Grafana: Open Dashboard"
      },
      {
        "command": "atGrafana.openAlertRule",
        "title": "AT Grafana: Open Alert Rule"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "atGrafana.refreshDashboards",
          "when": "view == atGrafana.dashboards",
          "group": "navigation@1"
        },
        {
          "command": "atGrafana.filterDashboards",
          "when": "view == atGrafana.dashboards",
          "group": "navigation@2"
        },
        {
          "command": "atGrafana.clearDashboardFilter",
          "when": "view == atGrafana.dashboards",
          "group": "navigation@3"
        },
        {
          "command": "atGrafana.refreshAlerts",
          "when": "view == atGrafana.alerts",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy:hub": "node scripts/copy-hub.mjs",
    "package": "npm run build && npm run copy:hub && node scripts/package.mjs"
  },
  "dependencies": {
    "@at-series/mcp-hub": "^0.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
